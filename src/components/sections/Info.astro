---
import Icon from '../ui/Icon.astro';
import MapArt from '../art/MapArt.astro';
import { siteConfig } from '../../site.config';
import { formatMoney } from '../../lib/money';
import { generalWhatsAppUrl } from '../../lib/whatsapp';

const waUrl = generalWhatsAppUrl();
---

<section class="section" id="ubicacion" aria-labelledby="info-title">
	<div class="page-wrap">
		<div class="section-head">
			<div class="section-head__row">
				<div class="max-w-2xl">
					<p class="eyebrow">Horario, delivery y ubicación</p>
					<h2 class="display-title mt-2" id="info-title">Cerca, fresco y a tu hora.</h2>
					<p class="lead mt-3">
						Estamos en {siteConfig.address.district}. Delivery a zonas cercanas o recojo en el
						local, como prefieras.
					</p>
				</div>
				<a class="btn btn--sm btn--whatsapp shrink-0" href={waUrl} target="_blank" rel="noopener noreferrer">
					<Icon name="whatsapp" size={17} />
					Coordinar delivery
				</a>
			</div>
		</div>

		<div class="info-grid">
			<div class="grid gap-4">
				<div class="info-card">
					<div class="flex items-center justify-between gap-3">
						<h3>Horario</h3>
						<span class="tag tag--blue">Todos los días</span>
					</div>
					<ul class="info-list">
						{
							siteConfig.hours.map((range) => (
								<li>
									<span>{range.label}</span>
									<span>{range.opens}–{range.closes}</span>
								</li>
							))
						}
					</ul>
					<p class="mt-3 text-xs font-medium text-[color:var(--color-on-surface-variant)]">
						Pedidos con 20 minutos de anticipación. Último pedido 30 minutos antes del cierre.
					</p>
				</div>

				<div class="info-card">
					<div class="flex items-center justify-between gap-3">
						<h3>Delivery</h3>
						<span class="tag tag--white">Se confirma por WhatsApp</span>
					</div>
					<div class="mt-2">
						{
							siteConfig.deliveryZones.map((zone) => (
								<div class="zone-row">
									<span class="zone-row__name">{zone.name}</span>
									<span class="zone-row__districts">
										{zone.districts.join(' · ')}
										<span class="block text-[0.7rem] font-semibold">{zone.note}</span>
									</span>
									<span class="zone-row__fee">desde {formatMoney(zone.fee)}</span>
								</div>
							))
						}
					</div>
					<p class="mt-3 text-xs font-medium text-[color:var(--color-on-surface-variant)]">
						{siteConfig.deliveryNote}
					</p>
				</div>

				<div class="info-card">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<h3>Pagos</h3>
						<div class="flex flex-wrap gap-2">
							{siteConfig.payments.map((payment) => <span class="tag tag--cream">{payment}</span>)}
						</div>
					</div>
					<p class="mt-3 text-sm text-[color:var(--color-on-surface-variant)]">
						También puedes pagar en el local. Para delivery, coordinamos el método por WhatsApp al
						confirmar tu pedido.
					</p>
				</div>
			</div>

			<div class="info-card map-card">
				<MapArt class="map-card__art" />
				<div class="map-card__overlay">
					<div class="flex items-start gap-2">
						<span class="icon-btn pointer-events-none h-10 w-10 shrink-0">
							<Icon name="pin" size={19} />
						</span>
						<div class="min-w-0">
							<p class="text-sm font-extrabold">{siteConfig.name}</p>
							<p class="text-sm text-[color:var(--color-on-surface-variant)]">
								{siteConfig.address.street}, {siteConfig.address.district}
							</p>
							<p class="mt-1 text-xs text-[color:var(--color-on-surface-variant)]">
								{siteConfig.address.reference}
							</p>
						</div>
					</div>
					<div class="mt-3 flex flex-wrap gap-2">
						<a
							class="btn btn--sm btn--primary"
							href={siteConfig.mapsUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Abrir en Google Maps
							<Icon name="arrow-up-right" size={16} />
						</a>
						<a class="btn btn--sm" href={waUrl} target="_blank" rel="noopener noreferrer">
							<Icon name="store" size={16} />
							Pedir recojo
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
