---
import Icon from '../ui/Icon.astro';

const navItems = [
	{ href: '#promos', label: 'Promos' },
	{ href: '#carta', label: 'Carta' },
	{ href: '#combos', label: 'Combos' },
	{ href: '#ubicacion', label: 'Ubicación' },
];
---

<header class="site-header" data-topbar>
	<div class="page-wrap site-header__inner">
		<a class="logo" href="/#inicio" aria-label="Guesa Hamburguesería, inicio">
			<span class="logo__mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
					<path d="M4 10c0-4 3.6-7 8-7s8 3 8 7H4Z" fill="#FFC83D" stroke="#0F1F4D" stroke-width="2"></path>
					<path d="M3 12h18" stroke="#0F1F4D" stroke-width="2"></path>
					<path d="M4 16c2 2 4 2 6 0 2 2 4 2 6 0 2 2 4 2 6 0" stroke="#7FB54B" stroke-width="2"></path>
					<path d="M4 19h16" stroke="#0F1F4D" stroke-width="2"></path>
				</svg>
			</span>
			<span>GUESA</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
			{navItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
		</nav>

		<div class="flex items-center gap-2">
			<a class="btn btn--sm btn--primary" href="#carta">
				<Icon name="bag" size={18} />
				<span>Pedir</span>
			</a>

			<details class="mobile-nav md:hidden">
				<summary class="icon-btn" aria-label="Abrir menú de navegación">
					<Icon name="menu" size={22} />
				</summary>
				<nav class="mobile-nav__panel" aria-label="Navegación móvil">
					{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
					<a href="#faq">Preguntas frecuentes</a>
				</nav>
			</details>
		</div>
	</div>
</header>
