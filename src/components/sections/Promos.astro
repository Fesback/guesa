---
import Icon from '../ui/Icon.astro';
import { formatMoney } from '../../lib/money';
import { getLimaDayLabel, type LimaDay } from '../../lib/today';

interface Promo {
	id: string;
	dia: LimaDay;
	titulo: string;
	detalle: string;
	precio: number;
	precioAnterior: number | null;
	etiqueta: string | null;
	tipo: 'combo' | 'upgrade' | 'gratis';
	orden: number;
	incluye: string[];
	requiereBurger: boolean;
	excluye: string[];
}

interface Props {
	promos: Promo[];
	today: LimaDay;
}

const { promos, today } = Astro.props;
const dayOrder: LimaDay[] = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo'];
const grouped = dayOrder
	.map((day) => ({
		day,
		label: getLimaDayLabel(day),
		offers: promos.filter((promo) => promo.dia === day).sort((a, b) => a.orden - b.orden),
	}))
	.filter((group) => group.offers.length > 0);

const todayPromos = promos.filter((promo) => promo.dia === today);
const todayLabel = getLimaDayLabel(today);
---

<section class="section" id="promos" aria-labelledby="promos-title" data-promos>
	<div class="page-wrap">
		<div class="section-head">
			<div class="section-head__row">
				<div class="max-w-2xl">
					<p class="eyebrow">Promos de la semana</p>
					<h2 class="display-title mt-2" id="promos-title">La semana sabe mejor.</h2>
					<p class="lead mt-3">
						Lunes, martes y jueves tienen precio especial. Hoy es {todayLabel}: revisa la tarjeta
						marcada y pide directo al carrito.
					</p>
				</div>
				<div class="hidden shrink-0 sm:block">
					<span class="tag tag--blue">
						<Icon name="sparkle" size={14} />
						{todayPromos.length ? `Hoy: ${todayPromos[0].titulo}` : 'Combos todos los días'}
					</span>
				</div>
			</div>
		</div>

		<div data-promo-pin>
			<div class="promo-scroller" data-promo-track>
				{
					grouped.map((group) => {
						const isToday = group.day === today;
						return (
							<article
								class="promo-card"
								data-promo-card
								data-day={group.day}
								data-today={isToday ? 'true' : 'false'}
							>
								<div class="promo-card__top">
									<h3 class="promo-card__day">{group.label}</h3>
									<span class="today-badge">
										<Icon name="star" size={12} />
										Hoy
									</span>
								</div>
								<div class="promo-card__body">
									{group.offers.map((offer) => (
										<div class="promo-card__offer">
											<div class="flex flex-wrap items-start justify-between gap-2">
												<div class="min-w-0">
													<h4 class="promo-card__title">{offer.titulo}</h4>
													{offer.etiqueta && <span class="tag tag--cream mt-2">{offer.etiqueta}</span>}
												</div>
												<div class="text-right">
													<p class="price price--ink">{formatMoney(offer.precio)}</p>
													{offer.precioAnterior && (
														<p class="price-old">antes {formatMoney(offer.precioAnterior)}</p>
													)}
												</div>
											</div>
											<p class="promo-card__note">{offer.detalle}</p>
											{offer.incluye.length > 0 && (
												<p class="text-xs font-semibold text-[color:var(--color-on-surface-variant)]">
													{offer.incluye.join(' · ')}
												</p>
											)}
											<div class="promo-card__actions">
												<button
													class="btn btn--sm btn--primary"
													type="button"
													data-promo-add
													data-product-id={offer.id}
													data-name={`${group.label}: ${offer.titulo}`}
													data-price={offer.precio}
													data-category="promos"
													data-requires-burger={offer.requiereBurger ? 'true' : 'false'}
													data-excludes={JSON.stringify(offer.excluye)}
													data-promo-day={offer.dia}
													data-day-label={group.label}
													disabled={!isToday}
												>
													<Icon name="plus" size={16} />
													<span data-promo-label>{isToday ? 'Agregar promo' : `Solo ${group.label.toLowerCase()}`}</span>
												</button>
												{offer.requiereBurger && (
													<span class="tag tag--white self-center">Se suma a tu burger</span>
												)}
											</div>
										</div>
									))}
								</div>
							</article>
						);
					})
				}
			</div>
		</div>

		<p class="mt-4 text-xs font-medium text-[color:var(--color-on-surface-variant)]">
			Precios en soles. Promos válidas solo el día indicado, hasta agotar stock. La promo del martes
			no aplica a Guesa Smash ni Five Guesa.
		</p>
	</div>
</section>
